exercicío 18
def calcular_media(numeros) :
    soma = 0
    
    for numero in numeros:
        soma = soma + numero
        
    media = soma / len(numeros)
    return media
    
lista = [10, 8, 6, 9, 7]

resultado = calcular_media(lista)

print ("Media:", resultado)

media: 8,0
