exercicío 17
def eh_primo(numero):
    if numero < 2:
       return False
       
    for i in range(2, numero):
        if numero % i == 0:
            return False
            
    return True
    
numero = int(input("Digite um número: "))

if eh_primo(numero):
    print("É primo!")
else:
    print("Não é primo!")

ditige um número [0]
