exercício 1
num1 = 20
num2 = 5

soma = num1 + num2
subtração = num1 - num2
multiplicação = num1 * num2
divisão = num1 / num2

print("Soma:", soma)
print("Subtração:", subtração)
print("multiplicação:", multiplicação)
print("divisão:", divisão)

Subtração: 15
multiplicação: 100
divisão: 4.0
