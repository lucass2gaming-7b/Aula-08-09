exercicío 19
def soma_diagonal_secundaria(matriz):
    soma = 0
    n = len(matriz)
    
    for i in range(n):
        soma += matriz[i][n - 1 - i]
        return soma
        
#Exemplo de matriz
matriz = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]
resultado = soma_diagonal_secundaria(matriz)
print("Soms da diagonal secundaria:", resultado)

soma diagonal secundaria: 3

